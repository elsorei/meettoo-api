# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL=postgresql://meettoo:CHANGE_ME@localhost:5432/meettoo

# Redis
REDIS_URL=redis://localhost:6379

# JWT — genera valori casuali forti, es: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Email (SMTP) — usato per verifica email e reset password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MeetToo <noreply@example.com>

# URL pubblico dell'API (usato nei link delle email)
APP_URL=http://localhost:3000

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gcalendar/callback

# Firebase (Push Notifications)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
