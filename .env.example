# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL=postgresql://meettoo:CHANGE_ME@localhost:5432/meettoo

# Redis
REDIS_URL=redis://localhost:6379

# JWT — genera valori casuali forti, es: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Email (SMTP) — usato per verifica email e reset password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MeetToo <noreply@example.com>

# URL pubblico dell'API (usato nei link delle email)
APP_URL=http://localhost:3000

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gcalendar/callback

# Firebase (Push Notifications)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# Numero di proxy fidati davanti all'app (Railway/PaaS = 1). Non alzarlo
# senza motivo: valori troppo alti rendono X-Forwarded-For spoofabile e il
# rate limiting aggirabile.
TRUST_PROXY=1

# Funnel invito → installazione (pagina web evento + universal/app links).
# APP_URL sopra deve essere il dominio pubblico https da cui è servita la
# pagina /e/<id> e i file .well-known.
APP_STORE_URL=https://apps.apple.com/app/idXXXXXXXXXX
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=it.studiorei.meettoo
APP_SCHEME=meettoo
# iOS: "<TEAM_ID>.<bundleIdentifier>" — Team ID da Apple Developer.
IOS_APP_ID=TEAMID.it.studiorei.meettoo
# Android: package + SHA-256 del certificato di firma (da `eas credentials`).
ANDROID_PACKAGE=it.studiorei.meettoo
ANDROID_SHA256=AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99
