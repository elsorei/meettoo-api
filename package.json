{
  "name": "meettoo-api",
  "version": "1.0.0",
  "description": "MeetToo Backend API - Node.js + TypeScript + Fastify",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && mkdir -p dist/migrations && cp src/migrations/*.sql dist/migrations/",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrations/run.ts",
    "migrate:legacy": "tsx src/migrations/legacy/migrate_from_mariadb.ts"
  },
  "keywords": [],
  "author": "Studio REI",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^9.0.0",
    "@types/mailparser": "^3.4.6",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.4",
    "firebase-admin": "^13.7.0",
    "googleapis": "^171.4.0",
    "imapflow": "^1.2.18",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.9.6",
    "mysql2": "^3.20.0",
    "nodemailer": "^8.0.4",
    "pg": "^8.20.0",
    "redis": "^5.11.0",
    "rrule": "^2.8.1",
    "socket.io": "^4.8.3",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mysql": "^2.15.27",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.20.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
